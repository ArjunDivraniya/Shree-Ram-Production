# ==============================================================================
# SHREE RAM PRODUCTION — NODEMAILER SMTP EMAIL CONFIGURATION
# ==============================================================================

# SMTP Service Provider Host (e.g. smtp.gmail.com for Google Workspace / Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT=465

# Secure SSL/TLS connection (true for 465, false for 587)
SMTP_SECURE=true

# Your Gmail address used to authenticate and send enquiries
SMTP_USER=shreeramproduction.in@gmail.com

# 16-Character Google App Password (NOT your standard account password)
# How to get it:
# 1. Go to Google Account > Security: https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to "App passwords": https://myaccount.google.com/apppasswords
# 4. Generate a password for "Shree Ram Production Website"
# 5. Paste the 16-character string here:
SMTP_PASS=your_16_character_app_password_here

# Recipient email where all client enquiries are automatically delivered
EMAIL_TO=shreeramproduction.in@gmail.com

# Friendly From header shown to recipients
EMAIL_FROM="Shree Ram Production" <shreeramproduction.in@gmail.com>

# Standalone Express Server Port
PORT=5000
